# FinanceOS — Backend Environment Configuration
#
# Copy this file to .env and supply your values.
# The application runs fully without OPENROUTER_API_KEY.
# Deterministic reconciliation always completes.
# AI investigation is disabled when no key is provided.

# Optional. Enables AI exception investigation via OpenRouter (Gemini Flash).
# Without this key, deterministic engine results are surfaced without AI explanation.
OPENROUTER_API_KEY=

# Optional. Frontend origin(s) allowed to call the API.
# Comma-separated. Use * to allow all origins (not recommended for production).
# Example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
